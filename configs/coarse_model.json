{
  "experiment_name": "ma_islands_coarse_unet_cv5",
  "dataset": {
    "image_statistics_manifest": "data/processed/ma_islands/manifests/image_statistics.csv",
    "cv_manifest": "data/splits/ma_islands/cv5_splits.csv",
    "coarse_dir": "data/processed/ma_islands/coarse",
    "target_width": 512,
    "target_height": 384,
    "image_resampling": "bilinear_with_anti_aliasing",
    "mask_resampling": "nearest_neighbor"
  },
  "model": {
    "in_channels": 1,
    "out_channels": 1,
    "encoder_channels": [16, 32, 64, 128],
    "bottleneck_dropout": 0.1
  },
  "training": {
    "random_seed": 2026,
    "folds": [0, 1, 2, 3, 4],
    "batch_size": 2,
    "num_workers": 0,
    "max_epochs": 50,
    "early_stopping_patience": 8,
    "early_stopping_min_delta": 0.0001,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "scheduler_factor": 0.5,
    "scheduler_patience": 3,
    "minimum_learning_rate": 0.00001,
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "soft_dice_smooth": 1.0,
    "prediction_threshold": 0.5,
    "horizontal_flip_probability": 0.5,
    "vertical_flip_probability": 0.5,
    "normalization": "train_fold_global_mean_std",
    "device": "auto",
    "cpu_threads": 8
  },
  "output_dir": "results/coarse_model"
}
